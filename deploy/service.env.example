LEFT_SERIAL=REPLACE_LEFT_SERIAL
RIGHT_SERIAL=REPLACE_RIGHT_SERIAL
CALIBRATION=/etc/dual-hik-stitch/site.calib
RTSP_URL=rtsp://127.0.0.1:8554/stitch
SYNC_MODE=device
# Set to the actual GevTimestampTickFrequency value verified on both cameras.
DEVICE_CLOCK_HZ=
TRIGGER_SOURCE=Line0
MAX_SKEW_US=1000
VIDEO_FPS=30
VIDEO_ENCODER=h264_rkmpp
STITCH_THREADS=2
# Optional exported MVS feature files to reapply on open and reconnect.
# LEFT_PROFILE=/etc/dual-hik-stitch/left.mfs
# RIGHT_PROFILE=/etc/dual-hik-stitch/right.mfs
# Set these only if the runtime libraries or encoder are not in the default search paths.
# LD_LIBRARY_PATH=/opt/MVS/lib/aarch64
# FFMPEG_BIN=/opt/ffmpeg-rockchip/bin/ffmpeg
